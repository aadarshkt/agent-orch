# Database Configuration
# Base connection string for PostgreSQL (supports both psycopg_pool and SQLAlchemy)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres?sslmode=disable

# Image registry pull credentials (used by the CLI executor for `docker login`)
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_URL=

# Root directory for per-execution workspaces (defaults to system temp)
# WORKSPACE_ROOT=/var/agent-orch/workspaces
