# Database Configuration
# Base connection string for PostgreSQL (supports both psycopg_pool and SQLAlchemy)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres?sslmode=disable

# Image registry pull credentials (used by the CLI executor for `docker login`)
# For GHCR: REGISTRY_URL=ghcr.io and REGISTRY_PASSWORD is a PAT with `read:packages`.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_URL=

# Root directory for per-execution workspaces (defaults to system temp).
# In production this must be an absolute path that exists identically on the host
# and inside the backend container, and be bind-mounted 1:1 — the nested
# `docker run -v <node_dir>:/workspace` resolves it against the host daemon.
# WORKSPACE_ROOT=/mnt/data/agent-orch/workspaces

# Comma-separated browser origins allowed by CORS. Unset = localhost dev origins.
# Must include the deployed frontend origin (e.g. https://app.vercel.app).
# Use `*` only when credentials are not needed.
# CORS_ORIGINS=https://app.vercel.app

# OpenRouter API key (used by the openrouter-agent CLI runtime preset)
OPENROUTER_API_KEY=

# GitHub token (used by git_commit's github_repo publishing to create repos and
# push, then return a commit URL). Needs 'repo' scope. Create one at
# https://github.com/settings/tokens
GITHUB_TOKEN=
